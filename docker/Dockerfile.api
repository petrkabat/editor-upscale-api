# Lightweight API image (no GPU / ML dependencies).
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY upscale_api ./upscale_api

EXPOSE 8000
CMD ["uvicorn", "upscale_api.api:app", "--host", "0.0.0.0", "--port", "8000"]
