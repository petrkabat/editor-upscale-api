# GPU-enabled worker image running Real-ESRGAN via arq.
# CUDA 12.8 + torch cu128 is required for Blackwell GPUs (RTX 50xx, sm_120).
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

# Python + libs required by opencv / basicsr.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3-pip \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/bin/python && \
    python -m pip install --no-cache-dir --upgrade pip

COPY requirements.txt requirements-worker.txt ./
# Install torch from the cu128 wheel index (Blackwell / sm_120 support), then
# the rest of the stack.
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 \
        --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir -r requirements-worker.txt

COPY upscale_api ./upscale_api

# torchvision >= 0.17 removed `functional_tensor`, which basicsr 1.4.2 still
# imports. Patch the file in place with sed (importing basicsr to patch it would
# itself trigger the broken import).
RUN find /usr -path '*/basicsr/data/degradations.py' -exec \
        sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' {} +

CMD ["arq", "upscale_api.worker.WorkerSettings"]
