# Copy to .env and adjust as needed.

# Storage
DATA_DIR=data
DATABASE_PATH=data/jobs.db
OUTPUT_DIR=data/outputs
WEIGHTS_DIR=data/weights

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Worker / Real-ESRGAN
DEFAULT_MODEL=realesrgan-x4plus
USE_GPU=true
# Tile size for low-VRAM / large images (0 = off). Needed for big inputs.
TILE_SIZE=0
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_IMAGE_BYTES=52428800
# Load the model at worker startup so the first job isn't a slow cold start.
PRELOAD_MODEL=true

# Cleanup
# Delete the downloaded input image once a job finishes.
DELETE_INPUT_AFTER=true
# Remove finished jobs (DB rows + result files) older than N hours. 0 disables.
RESULT_TTL_HOURS=24

# Public base URL so the result is returned as an absolute URL.
# e.g. https://upscale.example.com  (empty => relative /api/jobs/.../result)
PUBLIC_BASE_URL=

# API authentication. When set, every /api endpoint (except /api/health)
# requires "Authorization: Bearer <API_TOKEN>". Empty => open API.
API_TOKEN=

# Cloudflare Tunnel (named tunnel, profile "tunnel" only).
# Token from the Zero Trust dashboard; leave empty if you only use tunnel-quick.
CLOUDFLARE_TUNNEL_TOKEN=
