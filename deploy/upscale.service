# systemd unit to start the upscale stack on boot.
#
# Install (on the Ubuntu server):
#   sudo cp deploy/upscale.service /etc/systemd/system/upscale.service
#   # edit WorkingDirectory + the worker count / profile below to match yours
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now upscale.service
#
# Make sure Docker itself starts on boot too:
#   sudo systemctl enable docker
#
# Manage it:
#   sudo systemctl status upscale
#   sudo systemctl restart upscale       # re-applies `up -d`
#   sudo systemctl stop upscale          # compose down

[Unit]
Description=Real-ESRGAN upscale stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Absolute path to the cloned repo (holds docker-compose.yml and .env).
WorkingDirectory=/home/UPDATE_ME/editor-upscale-api
# Adjust the worker count; drop --profile tunnel if you don't run the tunnel.
ExecStart=/usr/bin/docker compose --profile tunnel up -d --scale worker=8
ExecStop=/usr/bin/docker compose --profile tunnel down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
